# Flask / JWT（本地开发可不填则使用 config.py 默认值；生产部署务必设置强随机密钥）
# SECRET_KEY=
# JWT_SECRET_KEY=

# 数据库（可选；不填则默认 SQLite fitmate.db）
# DATABASE_URL=

# 阿里云百炼 API 配置
# 申请地址：https://bailian.console.aliyun.com/

QWEN_API_KEY=your_api_key_here
QWEN_MODEL=qwen3.5-omni-plus
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 找回密码接口 /api/auth/reset-password 使用的服务端校验码（勿使用仓库默认值上线）
# 未配置时接口返回 503，避免误用未完成的真实短信网关。
# FITMATE_PASSWORD_RESET_CODE=