{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend/fitmate-frontend && npm ci && npm run build",
  "outputDirectory": "frontend/fitmate-frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://YOUR_BACKEND_HOST/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://YOUR_BACKEND_HOST/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
