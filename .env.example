# 仓库根目录环境变量示例（按部署方式把对应项写入 backend/.env 或 Docker / CI 密钥）

# ---------- Flask / JWT（生产环境必须设置强随机值，勿使用仓库默认占位符）----------
# SECRET_KEY=
# JWT_SECRET_KEY=

# ---------- 数据库 ----------
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/fitmate

# ---------- 阿里云通义千问（AI 功能）----------
# QWEN_API_KEY=
# QWEN_MODEL=qwen3.6-flash
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 找回密码（服务端校验码；勿提交真实验证码到 Git）----------
# 开发环境可设任意值；生产环境应接入短信/邮件真实验证码，或轮换服务端密钥。
# FITMATE_PASSWORD_RESET_CODE=

# ---------- 前端（Vite）----------
# VITE_API_BASE_URL=http://127.0.0.1:5000
