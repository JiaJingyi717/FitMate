# 仓库根目录环境变量示例（按部署方式把对应项写入 backend/.env 或 Docker / CI 密钥）

# ---------- Flask / JWT（生产环境必须设置强随机值，勿使用仓库默认占位符）----------
# SECRET_KEY=
# JWT_SECRET_KEY=

# ---------- Docker Compose ----------
# 开发：docker compose up -d（见 compose.yaml）
# 生产：复制 secrets/db_password.txt.example → secrets/db_password.txt，配置本文件后 ./deploy.sh
# 须与 MySQL 容器首次初始化时的密码一致（开发默认 123456，与 compose.yaml 默认相同）
# 若改过密码且登录 500，可执行 docker compose down -v 后重建数据卷，或改回正确密码
MYSQL_ROOT_PASSWORD=123456
# HTTP_PORT=80

# ---------- 监控 / 日志（可选）----------
# FITMATE_VERSION=1.0.0
# FITMATE_LOG_LEVEL=INFO
# FITMATE_LOG_JSON=1

# ---------- 数据库 ----------
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/fitmate

# ---------- 阿里云通义千问（AI 功能）----------
# QWEN_API_KEY=
# QWEN_MODEL=qwen3.5-omni-plus
# 计划生成建议用纯文本模型（更快）：qwen-plus / qwen-turbo
# QWEN_PLAN_MODEL=qwen-plus
# QWEN_PLAN_TIMEOUT=180
# QWEN_CHAT_MODEL=qwen-plus
# QWEN_CHAT_TIMEOUT=120
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# FITMATE_AI_PLAN_FALLBACK=1
# FITMATE_AI_CHAT_FALLBACK=1

# ---------- 找回密码（服务端校验码；勿提交真实验证码到 Git）----------
# 开发环境可设任意值；生产环境应接入短信/邮件真实验证码，或轮换服务端密钥。
# FITMATE_PASSWORD_RESET_CODE=

# ---------- 前端（Vite）----------
# VITE_API_BASE_URL=http://127.0.0.1:5000
